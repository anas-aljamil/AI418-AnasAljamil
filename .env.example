# Copy to .env (never commit .env) and fill in your own values.

# MySQL 8.0 connection used by scripts/reset_db.py, scripts/check_db.py and (from P2) the API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mawjood

# Path to the mysql command-line client if it is not on PATH, e.g. on Windows:
# MYSQL_CLI=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# API token signing key: a long random string, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# true when the API is served over HTTPS (the web refresh cookie is then Secure)
COOKIE_SECURE=false

# Optional: freeze the API clock for screenshots and demos (UTC), e.g. 2026-10-05T07:00:00Z
# (Monday 10:00 in Riyadh). Leave empty for the real time.
DEMO_NOW=
