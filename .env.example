# Copy to .env (never commit .env) and fill in your own values.

# MySQL 8.0 connection used by scripts/reset_db.py, scripts/check_db.py and (from P2) the API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mawjood

# Path to the mysql command-line client if it is not on PATH, e.g. on Windows:
# MYSQL_CLI=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
