# Copy to .env (never commit .env) and fill in your own values.

# MySQL 8.0 connection used by scripts/reset_db.py, scripts/check_db.py and (from P2) the API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mawjood

# Path to the mysql command-line client if it is not on PATH, e.g. on Windows:
# MYSQL_CLI=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe

# API token signing key: a long random string, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# true when the API is served over HTTPS (the web refresh cookie is then Secure)
COOKIE_SECURE=false

# Browser origins besides CORS_ORIGINS: by default the browser version opened from a phone on
# the same Wi-Fi (http://<private address>:8081). Leave empty for the default.
CORS_ORIGIN_REGEX=

# Folder of the exported browser version the API serves at / (default app/dist; empty = default).
WEB_DIR=

# Optional: freeze the API clock for screenshots and demos (UTC), e.g. 2026-10-05T07:00:00Z
# (Monday 10:00 in Riyadh). Leave empty for the real time.
DEMO_NOW=

# Self sign-up accepts only addresses at this domain (default university.example).
SIGNUP_EMAIL_DOMAIN=
# Rate limits per minute (defaults 5 and 5). Raise both for repeated Playwright runs.
LOGIN_ATTEMPTS_PER_MINUTE=
SIGNUPS_PER_MINUTE=
# The Help and contact form, per client address (default 3; it is open without an account).
CONTACT_MESSAGES_PER_MINUTE=

# "Forgot password" requests and resets per minute, per client address (default 3).
PASSWORD_RESETS_PER_MINUTE=

# Outgoing mail, only for the forgot-password link (Python's smtplib, STARTTLS).
# Leave SMTP_HOST empty to write each email to backend/outbox/ instead (for trying it out).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the address>, SMTP_PASSWORD=<an app
# password from the Google account's security settings, not the account password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where links in emails point when the request did not come through the public link's tunnel
# (default http://localhost:8000). Through the tunnel the link uses the public address itself.
PUBLIC_URL=
