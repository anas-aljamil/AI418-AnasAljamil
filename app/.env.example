# Optional. Copy to app/.env only when the app cannot find the backend on its own
# (phone hotspot, `npx expo start --tunnel`, university Wi-Fi). See docs/run-on-phone.md Section 4.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# The address behind "Email ..." on the Help and contact screen (a mailto link; Mawjood sends no
# email itself). Without it the screen tells people to ask their department's office.
# EXPO_PUBLIC_SUPPORT_EMAIL=mawjood-support@university.example
